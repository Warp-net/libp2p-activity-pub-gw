FROM golang:1.26 AS builder

COPY . /bridge-gateway
WORKDIR /bridge-gateway

ENV CGO_ENABLED=0

# The gateway builds straight from its Go module: it imports no warpnet Go
# packages (it speaks the wire protocol over native libp2p), so there are no
# submodules and no cgo — a plain module build is enough.
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags "-s -w" -o /usr/local/bin/bridge-gateway ./cmd/bridge-gateway

FROM gcr.io/distroless/static-debian12

# Persisted state — the RSA signing key and the Tailscale node identity (keeps
# the *.ts.net hostname stable across restarts) — lives in /data. Nothing else
# is ever written to disk (see CLAUDE.md).
ENV GATEWAY_KEY=/data/key.pem \
    GATEWAY_FUNNEL_DIR=/data/tsnet
VOLUME ["/data"]

COPY --from=builder /usr/local/bin/bridge-gateway /usr/local/bin/bridge-gateway
CMD ["/usr/local/bin/bridge-gateway"]
